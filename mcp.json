{
  "mcpServers": {
    "algobharat-carbon-credit-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Algorand",
        "PROJECT_TICKER": "ABECO"
      },
      "tools": [
        {
          "name": "verify_abeco_invariants",
          "description": "Verifies deterministic invariants for AlgoBharat Carbon Credit AI on Algorand."
        },
        {
          "name": "execute_abeco_action",
          "description": "Executes authenticated RWA state transition."
        }
      ]
    }
  }
}